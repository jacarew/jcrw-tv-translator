<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainStreamLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".stream.StreamActivity"
    android:keepScreenOn="true">

    <com.metallic.chiaki.stream.AspectRatioFrameLayout
        android:id="@+id/aspectRatioLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">
        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.metallic.chiaki.stream.AspectRatioFrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <fragment
        android:id="@+id/controlsFragment"
        android:name="com.metallic.chiaki.touchcontrols.DefaultTouchControlsFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <fragment
        android:id="@+id/touchpadOnlyFragment"
        android:name="com.metallic.chiaki.touchcontrols.TouchpadOnlyFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.metallic.chiaki.stream.SubtitleRegionView
        android:id="@+id/subtitleRegionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/translatedSubtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="110dp"
        android:background="#CC000000"
        android:gravity="center"
        android:maxWidth="1200dp"
        android:maxLines="2"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@color/stream_overlay_background"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/subtitleTranslateSwitch"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:layout_margin="3dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:text="Çeviri: Kapalı" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"
                    app:backgroundTint="@color/stream_quick_button_tint" app:strokeColor="#FFFFFFFF" app:strokeWidth="1dp" app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/subtitleRegionSwitch"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:layout_margin="3dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:text="OCR alanı" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"
                    app:backgroundTint="@color/stream_quick_button_tint" app:strokeColor="#FFFFFFFF" app:strokeWidth="1dp" app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/subtitleOcrResolutionButton"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:layout_margin="3dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:text="OCR: 720 px" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"
                    app:backgroundTint="@color/stream_quick_button_tint" app:strokeColor="#FFFFFFFF" app:strokeWidth="1dp" app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/subtitleVoiceoverSwitch"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:layout_margin="3dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:text="Ses: Kapalı" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"
                    app:backgroundTint="@color/stream_quick_button_tint" app:strokeColor="#FFFFFFFF" app:strokeWidth="1dp" app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hideOverlayButton"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:layout_margin="3dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:text="Gizle" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"
                    android:contentDescription="Kontrol menüsünü gizle"
                    app:backgroundTint="@color/stream_quick_button_tint" app:strokeColor="#FFFFFFFF" app:strokeWidth="1dp" app:cornerRadius="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/subtitleAppearanceButton"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1.5"
                    android:layout_margin="3dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:text="Altyazı ve ses ayarları" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold"
                    app:backgroundTint="@color/stream_quick_button_tint" app:strokeColor="#FFFFFFFF" app:strokeWidth="1dp" app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/autoOpenMenuButton"
                    android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                    android:layout_margin="3dp" android:minWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp"
                    android:text="Otomatik menü: Açık" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold"
                    app:backgroundTint="@color/stream_quick_button_tint" app:strokeColor="#FFFFFFFF" app:strokeWidth="1dp" app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/displayModeToggle"
                    android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
                    app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/display_mode_normal_button">
                    <com.google.android.material.button.MaterialButton android:id="@+id/display_mode_normal_button" android:layout_width="1dp" android:layout_height="1dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/display_mode_zoom_button" android:layout_width="1dp" android:layout_height="1dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/display_mode_stretch_button" android:layout_width="1dp" android:layout_height="1dp"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
